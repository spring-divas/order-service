apiVersion: v1
kind: Secret
metadata:
  name: order-secret
type: Opaque
stringData:
  DB_USERNAME: "order_user"
  DB_PASSWORD: "example_password"
  POSTGRES_DB: "order_db"
  POSTGRES_USER: "order_user"
  POSTGRES_PASSWORD: "example_password"

  DB_HOST: "order-db"
  DB_PORT: "5432"
  DB_NAME: "order_db"
  SERVER_PORT: "8080"
  PAYMENT_SERVICE_URL: "http://payment-service:8080"